# ── AI (Gemini 2.5 Flash) ────────────────────────
# Required. Gemini API key from https://aistudio.google.com/apikey
# Powers every tool: web search grounding, image analysis, translation,
# directions, price/event lookups, and direct Q&A.
GEMINI_API_KEY=AIza...

# ── Server ───────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Security ─────────────────────────────────────
# Optional. If empty, no authentication is enforced.
# When set, clients must send `Authorization: Bearer <token>` or `?token=<token>`.
MCP_AUTH_TOKEN=

# ── Logging ──────────────────────────────────────
# One of: debug | info | warn | error
LOG_LEVEL=info
