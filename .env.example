# ── AI ───────────────────────────────────────────
# Required. Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Default Claude model used for all completions (vision + complex reasoning)
CLAUDE_MODEL=claude-sonnet-4-6

# ── Search / 단순 작업 (Gemini 2.0 Flash) ─────────
# Required. Gemini API key from https://aistudio.google.com/apikey
# Used for web search grounding, translation, directions, price/event lookups.
GEMINI_API_KEY=AIza...

# ── Server ───────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Security ─────────────────────────────────────
# Optional. If empty, no authentication is enforced.
# When set, clients must send `Authorization: Bearer <token>` or `?token=<token>`.
MCP_AUTH_TOKEN=

# ── Logging ──────────────────────────────────────
# One of: debug | info | warn | error
LOG_LEVEL=info
